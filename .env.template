# VLMS Production Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret

# Server domain or IP address for CORS (e.g. ["http://192.168.1.100"])
CORS_ORIGINS=["http://YOUR_SERVER_IP"]

# Caddy: set to your domain (e.g. mind.torre.mx) for auto-HTTPS,
# or leave empty to serve plain HTTP on :80
SERVER_DOMAIN=

# Ngrok authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Ngrok custom domain (paid plan only) — leave empty for random URL
NGROK_DOMAIN=

# WhatsApp Cloud API credentials
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=vlms-verify-token
